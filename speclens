from typing import Iterable

ROOT = Path(__file__).resolve().parent
DPG_DIR = ROOT / "experiments" / "dpg_outputs"
CONTROL_DIR = ROOT / "experiments" / "control_outputs"
AUDIT_LOG = ROOT / "data" / "governance" / "control_events.jsonl"

BASELINE_HIGH = 0.60
GLOBAL_HIGH = 0.50


def title(text: str) -> None:
    print()
    print("=" * 72)
    print(text)
    print("=" * 72)


def run_cmd(
    args: list[str],
    *,
    label: str,
    capture: bool = True,
    cwd: Path = ROOT,
) -> str:
    print(f"[...] {label}")
    result = subprocess.run(
        args,
        cwd=cwd,
        text=True,
        stdout=subprocess.PIPE if capture else None,
        stderr=subprocess.STDOUT if capture else None,
    )
    if result.returncode != 0:
        print(f"[ERROR] {label} failed.")
        if capture and result.stdout:
            print("\n--- command output ---")
            print(result.stdout[-8000:])
        raise SystemExit(result.returncode)

    print(f"[OK]  {label}")
    return result.stdout or ""


def count_csv_rows(path: Path) -> int | None:
    if not path.exists():
        return None
    with path.open(newline="", encoding="utf-8") as f:
        return sum(1 for _ in csv.DictReader(f))


def model_name(path: Path) -> str:
    if not path.exists():
        return "not available"
    try:
        import joblib
        model = joblib.load(path)
        name = type(model).__name__
        if name == "Pipeline" and getattr(model, "steps", None):
            name = type(model.steps[-1][1]).__name__
        return name
    except Exception:
        return "best_model.pkl"


