#!/usr/bin/env python3
"""
SpecLens-PML simplified CLI.

Commands:
  ./speclens reset
  ./speclens run [--continue]
  ./speclens control [--no-open]
  ./speclens govern [FILE]
  ./speclens govern --approve EVENT_ID [--reason TEXT]
  ./speclens govern --override EVENT_ID LEVEL --reason TEXT
  ./speclens graph [global|community]
  ./speclens all
"""

from __future__ import annotations

