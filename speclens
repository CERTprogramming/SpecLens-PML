FUNC_RE = re.compile(r"^- (?P<name>.+?) \(line \d+\)$")
POLICY_RE = re.compile(r"^\s+(?P<id>P\d{3}) - ")
EVIDENCE_RE = re.compile(r"^\s+evidence:\s*(?P<text>.+)$")


def parse_inference(output: str) -> list[dict]:
    records: list[dict] = []
    current: dict | None = None

    for raw in output.splitlines():
        line = raw.rstrip()

        m = FUNC_RE.match(line)
        if m:
            if current:
                records.append(current)
            current = {
                "function": m.group("name"),
                "policies": [],
                "evidence": [],
            }
            continue

        if current is None:
            continue

        stripped = line.strip()

        if stripped.startswith("Model risk score:"):
            current["score"] = stripped.split(":", 1)[1].strip()
        elif stripped.startswith("Original risk level:"):
            current["original"] = stripped.split(":", 1)[1].strip()
        elif stripped.startswith("Controlled risk level:"):
            current["controlled"] = stripped.split(":", 1)[1].strip()
        elif stripped.startswith("Decision changed:"):
            current["changed"] = stripped.split(":", 1)[1].strip()
        elif stripped.startswith("Human review:"):
            current["review"] = stripped.split(":", 1)[1].strip()
        elif stripped.startswith("Governance event:"):
            current["event"] = stripped.split(":", 1)[1].strip()
        else:
            pm = POLICY_RE.match(line)
            if pm:
                current["policies"].append(pm.group("id"))
            em = EVIDENCE_RE.match(line)
            if em:
                current["evidence"].append(em.group("text"))

    if current:
        records.append(current)

    return records


def print_govern_summary(path: Path, output: str) -> None:
    records = parse_inference(output)

    title("SPECLENS GOVERN — SUMMARY")
    print(f"File: {path}")
    print()

    if not records:
        print("No function records could be parsed.")
        print("\nRaw output:")
        print(output)
        return

    header = f"{'Function':<22} {'Score':>6}  {'Original':<8} {'Controlled':<10} {'Policies':<10} {'Review'}"
    print(header)
    print("-" * len(header))

    for r in records:
        policies = ",".join(r.get("policies", [])) or "-"
        print(
            f"{r.get('function', '?'):<22} "
            f"{r.get('score', '?'):>6}  "
            f"{r.get('original', '?'):<8} "
            f"{r.get('controlled', '?'):<10} "
            f"{policies:<10} "
            f"{r.get('review', '?')}"
        )

    review_records = [
        r for r in records
        if r.get("review") == "required" and r.get("event") not in (None, "none")
    ]

    print()
    if review_records:
        print("Human review required:")
        for r in review_records:
            print(
                f"\n  {r.get('function')} | "
                f"score={r.get('score')} | "
                f"{r.get('original')} → {r.get('controlled')} | "
                f"policies={','.join(r.get('policies', []))}"
            )
            for evidence in r.get("evidence", []):
                print(f"    why: {evidence}")
            print(f"    event: {r.get('event')}")
    else:
        print("Human review required: none")

    print()
    print("Interpretation:")
    print("  • Score = unchanged model probability.")
    print("  • Original = baseline operational decision.")
    print("  • Controlled = decision after matched governance policies.")
    print("  • Review = human approval/override is required only if the decision changed.")


def command_govern_file(path: Path) -> None:
    if not path.is_absolute():
        path = ROOT / path
    if not path.exists():
        raise SystemExit(f"Input file not found: {path}")

    output = run_cmd(
        [sys.executable, "inference/predict.py", str(path)],
        label=f"Governed inference on {path.name}",
    )
    print_govern_summary(path, output)


def command_review_approve(event_id: str, reason: str | None) -> None:
    args = [
        sys.executable,
        "governance/review.py",
        event_id,
        "--approve",
    ]
    if reason:
        args += ["--reason", reason]
    output = run_cmd(args, label="Approve controlled decision")
    title("HUMAN REVIEW RECORDED")
    print(output.strip())


def command_review_override(event_id: str, level: str, reason: str) -> None:
    output = run_cmd(
        [
            sys.executable,
            "governance/review.py",
            event_id,
            "--override",
            level,
            "--reason",
            reason,
        ],
        label="Override controlled decision",
    )
    title("HUMAN REVIEW RECORDED")
    print(output.strip())


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="./speclens",
        description="Simple front-end for the SpecLens-PML workflow.",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    sub.add_parser(
        "reset",
        help="Clean generated runtime artifacts while preserving versioned inputs.",
    )

    p_run = sub.add_parser("run", help="Clean end-to-end MLOps run.")
    p_run.add_argument(
        "--continue",
        dest="continue_mode",
        action="store_true",
        help="Do not reset; keep feedback/runtime state for the next learning cycle.",
    )

    p_control = sub.add_parser(
        "control",
        help="Run DPG explanation + concept analysis + control evaluation.",
    )
    p_control.add_argument(
        "--no-open",
        action="store_true",
        help="Do not automatically open the simplified global graph.",
    )

    p_graph = sub.add_parser("graph", help="Open the latest generated DPG graph.")
    p_graph.add_argument(
        "kind",
        nargs="?",
        choices=("global", "community"),
        default="global",
    )

    p_govern = sub.add_parser(
        "govern",
        help="Run governed inference or record a human review.",
    )
    p_govern.add_argument(
        "file",
        nargs="?",
        default="data/raw_test/example102.py",
        help="Python file to analyze (default: data/raw_test/example102.py).",
    )
    group = p_govern.add_mutually_exclusive_group()
    group.add_argument("--approve", metavar="EVENT_ID")
    group.add_argument(
        "--override",
        nargs=2,
        metavar=("EVENT_ID", "LEVEL"),
    )
    p_govern.add_argument("--reason", help="Human-review rationale.")

    sub.add_parser(
        "all",
        help="Clean run + control evaluation + governance demo + open graph.",
    )

    return parser


def main() -> None:
    os.chdir(ROOT)
    parser = build_parser()
    args = parser.parse_args()

    if args.command == "reset":
        command_reset()

    elif args.command == "run":
        command_run(args.continue_mode)

    elif args.command == "control":
        command_control(open_graph_after=not args.no_open)

    elif args.command == "graph":
        command_graph(args.kind)

    elif args.command == "govern":
        if args.approve:
            command_review_approve(args.approve, args.reason)
        elif args.override:
            event_id, level = args.override
            level = level.upper()
            if level not in {"LOW", "MEDIUM", "HIGH"}:
                raise SystemExit("Override LEVEL must be LOW, MEDIUM, or HIGH.")
            if not args.reason:
                raise SystemExit("--reason is required for an override.")
            command_review_override(event_id, level, args.reason)
        else:
            command_govern_file(Path(args.file))

    elif args.command == "all":
        command_run(False)
        command_control(open_graph_after=False)
        command_govern_file(Path("data/raw_test/example102.py"))
        print()
        command_graph("global")


if __name__ == "__main__":
    main()
