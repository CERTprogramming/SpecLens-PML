def csv_rows(path: Path) -> list[dict[str, str]]:
    with path.open(newline="", encoding="utf-8") as f:
        return list(csv.DictReader(f))


def metrics(truth: list[int], pred: list[int]) -> dict[str, float | int]:
    tp = sum(t == 1 and p == 1 for t, p in zip(truth, pred))
    tn = sum(t == 0 and p == 0 for t, p in zip(truth, pred))
    fp = sum(t == 0 and p == 1 for t, p in zip(truth, pred))
    fn = sum(t == 1 and p == 0 for t, p in zip(truth, pred))
    precision = tp / (tp + fp) if tp + fp else 0.0
    recall = tp / (tp + fn) if tp + fn else 0.0
    f1 = (
        2 * precision * recall / (precision + recall)
        if precision + recall
        else 0.0
    )
    accuracy = (tp + tn) / len(truth) if truth else 0.0
    return {
        "accuracy": accuracy,
        "precision": precision,
        "recall": recall,
        "f1": f1,
        "fn": fn,
        "fp": fp,
    }


def print_metric_row(name: str, m: dict[str, float | int]) -> None:
    print(
        f"{name:<20} "
        f"recall={m['recall']:.3f}  "
        f"precision={m['precision']:.3f}  "
        f"F1={m['f1']:.3f}  "
        f"FN={m['fn']}  FP={m['fp']}"
    )


def dpg_summary() -> tuple[int | None, int | None, int | None]:
    """
    Read authoritative DPG counts from generated summary artifacts.

    global_summary.txt is preferred for node/edge counts because it reports
    explanation.graph.number_of_nodes()/number_of_edges() directly.

    community_class_summary.csv is preferred for community count because the raw
    dpg_communities.csv export may use the DPG library's long-form
    Section/Key/Value representation rather than a simple Community column.
    """
    nodes = None
    edges = None
    communities = None

    summary_path = DPG_DIR / "global_summary.txt"
    if summary_path.exists():
        summary = summary_path.read_text(encoding="utf-8", errors="replace")

        node_match = re.search(r"^DPG nodes:\s*(\d+)\s*$", summary, re.MULTILINE)
        edge_match = re.search(r"^DPG edges:\s*(\d+)\s*$", summary, re.MULTILINE)

        if node_match:
            nodes = int(node_match.group(1))
        if edge_match:
            edges = int(edge_match.group(1))

    # Safe fallbacks if the text summary is unavailable.
    if nodes is None:
        nodes = count_csv_rows(DPG_DIR / "dpg_node_metrics.csv")
    if edges is None:
        edges = count_csv_rows(DPG_DIR / "dpg_edge_metrics.csv")

    community_summary = DPG_DIR / "community_class_summary.csv"
    if community_summary.exists():
        communities = count_csv_rows(community_summary)

    return nodes, edges, communities


def read_community_explanations(top_concepts: int = 4) -> list[dict]:
    """
    Build a concise, human-readable summary of DPG communities.

    Community class association comes from community_class_summary.csv.
    "Main concepts" are ranked only by Predicate count in
    community_concept_summary.csv. They are descriptive structural summaries,
    not causal claims and not automatically learned governance rules.
    """
    class_path = DPG_DIR / "community_class_summary.csv"
    concept_path = DPG_DIR / "community_concept_summary.csv"

    if not class_path.exists():
        return []

    class_rows = csv_rows(class_path)
    concept_rows = csv_rows(concept_path) if concept_path.exists() else []

    concepts_by_community: dict[str, list[dict[str, str]]] = {}
    for row in concept_rows:
        key = row.get("Community", "")
        concepts_by_community.setdefault(key, []).append(row)

    result: list[dict] = []

    for row in class_rows:
        community_key = row.get("Community", "")
        dominant = (row.get("Dominant class") or "?").upper()
        display = row.get("Display label") or community_key or "Community"

        try:
            predicate_count = int(float(row.get("Predicate count", "0")))
        except ValueError:
            predicate_count = 0

        def pct(field: str) -> float:
            try:
                return float(row.get(field, "0")) * 100.0
            except ValueError:
                return 0.0

        concept_rows_for_community = concepts_by_community.get(community_key, [])

        def concept_count(item: dict[str, str]) -> int:
            try:
                return int(float(item.get("Predicate count", "0")))
            except ValueError:
                return 0

        ranked = sorted(
            concept_rows_for_community,
            key=concept_count,
            reverse=True,
        )[:top_concepts]

        main_concepts = [
            (item.get("Concept", "?"), concept_count(item))
            for item in ranked
        ]

        representative = [
            part.strip()
            for part in (row.get("Top by local reaching") or "").split(";")
            if part.strip()
        ][:3]

        result.append(
            {
                "display": display,
                "dominant": dominant,
                "predicate_count": predicate_count,
                "safe_pct": pct("SAFE association score"),
                "risky_pct": pct("RISKY association score"),
                "main_concepts": main_concepts,
                "representative": representative,
            }
        )

    return result


def print_community_explanations() -> None:
    communities = read_community_explanations()
    if not communities:
        print("Community interpretation: not available")
        return

    print("Community interpretation:")
    print()

    for community in communities:
        print(f"  {community['display']}")
        print(f"    Predicate nodes : {community['predicate_count']}")
        print(
            "    Association     : "
            f"RISKY {community['risky_pct']:.1f}% | "
            f"SAFE {community['safe_pct']:.1f}%"
        )

        concepts = community["main_concepts"]
        if concepts:
            print("    Main concepts   :")
            for name, count in concepts:
                print(f"      - {name} ({count})")

        representative = community["representative"]
        if representative:
            print("    Representative :")
            for predicate in representative:
                print(f"      - {predicate}")

        print()

    print(
        "  Note: community associations and concept counts are descriptive "
        "properties of the DPG, not causal claims."
    )


def print_control_summary() -> None:
    pred_path = CONTROL_DIR / "control_predictions.csv"
    if not pred_path.exists():
        print("[WARN] control_predictions.csv was not generated.")
        return

    rows = csv_rows(pred_path)
    truth = [int(float(r["true_label"])) for r in rows]
    scores = [float(r["model_score"]) for r in rows]
    baseline = [int(float(r["baseline_risky"])) for r in rows]
    controlled = [int(float(r["controlled_risky"])) for r in rows]
    global_050 = [int(score >= GLOBAL_HIGH) for score in scores]

    baseline_m = metrics(truth, baseline)
    global_m = metrics(truth, global_050)
    controlled_m = metrics(truth, controlled)

    nodes, edges, communities = dpg_summary()

    title("SPECLENS CONTROL — SUMMARY")
    print(
        "DPG structure   : "
        f"{nodes if nodes is not None else 'n/a'} nodes, "
        f"{edges if edges is not None else 'n/a'} edges, "
        f"{communities if communities is not None else 'n/a'} communities"
    )
    print()
    print_community_explanations()
    print()
    print("Operational control:")
    print()
    print_metric_row("Baseline HIGH=0.60", baseline_m)
    print_metric_row("Global HIGH=0.50", global_m)
    print_metric_row("Policy controlled", controlled_m)

    changed_idx = [i for i, (a, b) in enumerate(zip(baseline, controlled)) if a != b]
    differences = [i for i, (a, b) in enumerate(zip(global_050, controlled)) if a != b]

    print()
    print(f"Policy decisions changed : {len(changed_idx)}")
    print(
        "Global 0.50 vs policies : "
        + ("same decisions on this dataset" if not differences else f"{len(differences)} differences")
    )

    if changed_idx:
        print()
        print("Changed cases:")
        for i in changed_idx:
            r = rows[i]
            file_name = r.get("file", "?")
            fn = r.get("function", "?")
            policies = (r.get("matched_policy_ids", "-") or "-").replace(";", ",")
            print(
                f"  • {file_name} :: {fn} | "
                f"score={scores[i]:.3f} | MEDIUM→HIGH | {policies}"
            )

    print()
    print("Interpretation:")
    print("  • The DPG communities summarize structural associations in the Random Forest.")
    print("  • Lower FN / higher RISKY recall means fewer risky functions are missed.")
    print("  • The model score is unchanged; policies only affect the operational threshold.")
    if not differences:
        print("  • Here, global 0.50 and policy control are predictively equivalent.")
        print("  • The policy-layer contribution is selective, explainable and auditable control.")
    else:
        print("  • Here, policy control differs from a global 0.50 threshold.")

    print()
    print("Graph: ./speclens graph")
    print("Governance demo: ./speclens govern")


def open_file(path: Path) -> None:
    if not path.exists():
        raise SystemExit(f"Graph not found: {path}")

    opener: list[str] | None = None
    if shutil.which("xdg-open"):
        opener = ["xdg-open", str(path)]
    elif shutil.which("gio"):
        opener = ["gio", "open", str(path)]
    elif sys.platform == "darwin" and shutil.which("open"):
        opener = ["open", str(path)]

    if opener is None:
        print(f"Open this file manually:\n{path}")
        return

    try:
        subprocess.Popen(
            opener,
            cwd=ROOT,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        print(f"[OK] Opened graph: {path}")
    except Exception as exc:
        print(f"[WARN] Could not open graph automatically: {exc}")
        print(f"Open manually: {path}")


def command_graph(kind: str = "global") -> None:
    if kind == "community":
        candidates = [
            DPG_DIR / "simplified_community_dpg.svg",
            DPG_DIR / "simplified_community_dpg.png",
        ]
    else:
        candidates = [
            DPG_DIR / "simplified_global_dpg.svg",
